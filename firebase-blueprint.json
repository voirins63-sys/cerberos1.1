{
  "entities": {
    "Cartel": {
      "title": "Cartel",
      "description": "Root cartel workspace document",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "ownerUid", "createdAt", "updatedAt"]
    },
    "CartelAuthConfig": {
      "title": "CartelAuthConfig",
      "description": "Private configuration storing the editor secret code",
      "type": "object",
      "properties": {
        "secretCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["secretCode", "updatedAt", "updatedBy"]
    },
    "CartelMember": {
      "title": "CartelMember",
      "description": "Authenticated cartel member role state without PII",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["viewer", "editor"]
        },
        "accessCode": {
          "type": "string",
          "maxLength": 64
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "accessCode", "joinedAt", "updatedAt"]
    },
    "MissionsState": {
      "title": "MissionsState",
      "description": "Shared weekly mission statuses, redistributed daily schedule overrides, gains, losses, and selected players",
      "type": "object",
      "properties": {
        "week": {
          "type": "string",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "entries": {
          "type": "object"
        },
        "scheduleOverrides": {
          "type": "object",
          "description": "Map of missionId to reassigned day name after 09:30 automatic recalculation"
        },
        "unplacedMissionIds": {
          "type": "array",
          "description": "Bounded list of overdue mission IDs that cannot be rescheduled without exceeding regulation limits"
        },
        "lastRecalcDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastRecalcAt": {
          "type": "string",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["week", "entries", "updatedAt", "updatedBy"]
    },
    "InventoryState": {
      "title": "InventoryState",
      "description": "Shared cartel equipment inventory stock counts, custom item prices, and weapons arsenal",
      "type": "object",
      "properties": {
        "stock": {
          "type": "object",
          "description": "Bounded map (up to 100 keys) of equipment, ammo, accessory, and catalog item quantities"
        },
        "prices": {
          "type": "object",
          "description": "Bounded map (up to 100 keys) of custom unit price overrides for inventory items"
        },
        "weapons": {
          "type": "object",
          "description": "Weapons arsenal entries (name, value, qty, holderId, notes)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["stock", "updatedAt", "updatedBy"]
    },
    "TreasuryState": {
      "title": "TreasuryState",
      "description": "Shared cartel legal/illegal money, black market rewards, and global weapons loss",
      "type": "object",
      "properties": {
        "legal": {
          "type": "number"
        },
        "illegal": {
          "type": "number"
        },
        "rewards": {
          "type": "object"
        },
        "weaponsLossAmount": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["legal", "illegal", "rewards", "weaponsLossAmount", "updatedAt", "updatedBy"]
    },
    "HierarchyState": {
      "title": "HierarchyState",
      "description": "Shared cartel roster, hierarchy assignments, and member ranking adjustments",
      "type": "object",
      "properties": {
        "members": {
          "type": "object"
        },
        "rankings": {
          "type": "object",
          "description": "Per-member bonus/malus points, evaluation notes, and manual distinctions"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["members", "updatedAt", "updatedBy"]
    },
    "CatalogState": {
      "title": "CatalogState",
      "description": "Shared supplier/gang catalog with group contacts and items they sell or buy back",
      "type": "object",
      "properties": {
        "groups": {
          "type": "object",
          "description": "Map of groupId to group profile (name, specialty, color, notes, contacts, items)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["groups", "updatedAt", "updatedBy"]
    },
    "AlbumState": {
      "title": "AlbumState",
      "description": "Shared cartel photo album metadata index and favorite photo IDs",
      "type": "object",
      "properties": {
        "photos": {
          "type": "object",
          "description": "Bounded map (up to 100 entries) of custom photo metadata records"
        },
        "favorites": {
          "type": "array",
          "description": "Bounded list (up to 150) of favorited photo IDs across built-in and custom photos"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["photos", "favorites", "updatedAt", "updatedBy"]
    },
    "AlbumMedia": {
      "title": "AlbumMedia",
      "description": "Individual uploaded cartel photo payload document (isolated per photo to stay under 1MB)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700000
        },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "imageUrl", "mimeType", "createdBy", "createdAt", "updatedAt"]
    },
    "CartelDiscordConfig": {
      "title": "CartelDiscordConfig",
      "description": "Private editor-only configuration for Discord daily gazette webhook and 09:30 schedule",
      "type": "object",
      "properties": {
        "webhookUrl": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^$|^https://(discord|discordapp)\\.com/api/webhooks/[0-9]+/[A-Za-z0-9._\\-]+$"
        },
        "autoEnabled": {
          "type": "boolean"
        },
        "sendHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "sendMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "includePhoto": {
          "type": "boolean"
        },
        "customMessage": {
          "type": "string",
          "maxLength": 300
        },
        "lastSentDate": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "lastSentAt": {
          "type": "string",
          "maxLength": 40
        },
        "lastSentBy": {
          "type": "string",
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": [
        "webhookUrl",
        "autoEnabled",
        "sendHour",
        "sendMinute",
        "includePhoto",
        "customMessage",
        "lastSentDate",
        "lastSentAt",
        "lastSentBy",
        "updatedAt",
        "updatedBy"
      ]
    },
    "HistoryState": {
      "title": "HistoryState",
      "description": "Shared archived previous weeks and Sunday cartel payroll state",
      "type": "object",
      "properties": {
        "archives": {
          "type": "object",
          "description": "Bounded map (up to 60 entries) of archived global weekly activity summaries (operations, global wealth/treasury snapshot, notes, daily stats, mission logs, and Sunday payroll records)"
        },
        "currentPayroll": {
          "type": "object",
          "description": "Active week Sunday payroll tracking state (basis, split, paid member IDs, settlement details)"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": ["archives", "currentPayroll", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/cartels/{cartelId}": {
      "schema": { "$ref": "#/entities/Cartel" },
      "description": "Root cartel workspace document"
    },
    "/cartels/{cartelId}/private/auth": {
      "schema": { "$ref": "#/entities/CartelAuthConfig" },
      "description": "Private editor secret code configuration"
    },
    "/cartels/{cartelId}/private/discord": {
      "schema": { "$ref": "#/entities/CartelDiscordConfig" },
      "description": "Private Discord webhook and daily gazette auto-send settings (editors only)"
    },
    "/cartels/{cartelId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/CartelMember" },
      "description": "Authenticated cartel member access role"
    },
    "/cartels/{cartelId}/state/missions": {
      "schema": { "$ref": "#/entities/MissionsState" },
      "description": "Live weekly mission statuses and player participations"
    },
    "/cartels/{cartelId}/state/inventory": {
      "schema": { "$ref": "#/entities/InventoryState" },
      "description": "Live cartel equipment stock"
    },
    "/cartels/{cartelId}/state/treasury": {
      "schema": { "$ref": "#/entities/TreasuryState" },
      "description": "Live cartel treasury and global losses"
    },
    "/cartels/{cartelId}/state/hierarchy": {
      "schema": { "$ref": "#/entities/HierarchyState" },
      "description": "Live cartel hierarchy roster"
    },
    "/cartels/{cartelId}/state/catalog": {
      "schema": { "$ref": "#/entities/CatalogState" },
      "description": "Live catalog of external groups, contacts, and buy/sell prices"
    },
    "/cartels/{cartelId}/state/album": {
      "schema": { "$ref": "#/entities/AlbumState" },
      "description": "Shared cartel photo album metadata index and favorited photo IDs"
    },
    "/cartels/{cartelId}/state/history": {
      "schema": { "$ref": "#/entities/HistoryState" },
      "description": "Archived previous weeks and Sunday payroll tracking"
    },
    "/cartels/{cartelId}/albumMedia/{photoId}": {
      "schema": { "$ref": "#/entities/AlbumMedia" },
      "description": "Individual uploaded cartel photo payload referenced by state/album"
    }
  }
}
